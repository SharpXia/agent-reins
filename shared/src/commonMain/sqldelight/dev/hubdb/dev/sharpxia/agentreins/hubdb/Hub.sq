-- Hub 投影库 v4（v3 = 契约 v1.1.0 去 session 化，tag hub-api-v1.1.1）。
-- 全部表都是 Hub 快照+事件流的派生投影，可随时整库丢弃重建（05 §3.12）；
-- 例外 hubCommands/hubSyncState 属于 O-01 持久化最小集（发送队列含幂等键、eventCursor）。
--
-- v4（2026-11-05 additive，wp-5 流式投影修复）：
--   hubMessages 增 reason（失败原因，事件路径 message.failed.reason 与快照路径
--   MessageRow.errorKind 共用同一列——wp-4 additive 六值脱敏闭集）；
--   hubConversations 增 activeRunId（run.* 事件捕获当前活跃 runId，wp-8 Stop 按钮取值，
--   REST #11 run.cancel 路径参数必带 runId；hasActiveRun=0 的写路径一律连带清空，防死 runId 残留）；
--   缺行 message.delta 建 streaming 占位行（wp-1 探针定档无锚 delta，dstream:<runId> 合成身份
--   与 created 行异锚）+ 权威终态落定时清除同会话其余流式占位行。
-- v5（2026-11-05 additive，wp-11）：hubConversations 增 gatewayId（契约 ConversationRow required
--   字段，此前投影落库即丢——卡片无法归属网关，#16 新建会话入口无 (gatewayId, agentId) 可判）。
-- v1.1 关键契约事实（08 §8.1/§8.5）：REST ConversationRow 撤 sessionKey/sessionId/lifecycleRevision，
-- 事件信封按域带 sessionKey（eventlog 强制校验：message/session/tool/approval/run 域必带、
-- gateway/read 域不带）——两域无交集字段。因此：
--   卡片主键 = conversationId（快照/列表校准是卡片唯一来源；「UI 只见 conversation」）；
--   事件路由 = hubConvKeys 映射表 (gatewayId, sessionKey) → conversationId；
--   映射学习 = 自发送回执链（message.created 的 idempotencyKey → 命令队列 conversationId）
--   与自命令 ack（信封 sessionKey + 队列条目）；未映射事件不建卡，R4 周期校准兜底。

CREATE TABLE hubGateways (
    gatewayId TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    online INTEGER NOT NULL DEFAULT 0,
    lastSeenAt TEXT,
    agentsJson TEXT NOT NULL DEFAULT '[]'   -- AgentRef 数组原样 JSON（只读展示，不建关系）
);

CREATE TABLE hubConversations (
    conversationId TEXT NOT NULL PRIMARY KEY,  -- Hub ULID 句柄，化身更替后不变（05 §3.10）
    gatewayId TEXT NOT NULL DEFAULT '',        -- v5：归属网关（ConversationRow required；wp-11 #16 入口判据 + 网关维度展示）
    sessionKey TEXT,                           -- 映射学习成果（事件路由加速）；快照行无此值
    label TEXT NOT NULL DEFAULT '',
    agentId TEXT NOT NULL DEFAULT '',
    lastMessagePreview TEXT NOT NULL DEFAULT '',
    lastSeq INTEGER NOT NULL DEFAULT 0,        -- 当前化身内最新消息 seq（新化身从 1 重计）
    lastActiveAt TEXT NOT NULL DEFAULT '',
    unreadCount INTEGER NOT NULL DEFAULT 0,
    hasActiveRun INTEGER NOT NULL DEFAULT 0,
    activeRunId TEXT,                          -- v4：run.* 事件捕获的当前活跃 runId（wp-8 Stop 取值）；inactive 即清空
    reconciling INTEGER NOT NULL DEFAULT 0,
    -- 化身围栏持久基准（事件 session.updated 衍生态，非 REST 面镜像）：-1=未知（快照行），
    -- 首个事件只记录；之后 revision 变化即化身更替（清消息/重置 seq/unread/cursor）。
    lifecycleRevision INTEGER NOT NULL DEFAULT -1
);
CREATE INDEX hubConversations_byActive ON hubConversations(lastActiveAt DESC);

-- 事件路由映射：卡片键（conversationId）与事件键（gatewayId, sessionKey）的桥（见文件头）。
CREATE TABLE hubConvKeys (
    gatewayId TEXT NOT NULL,
    sessionKey TEXT NOT NULL,               -- 原样保留不解析（ADR-14）
    conversationId TEXT NOT NULL,
    PRIMARY KEY (gatewayId, sessionKey)
);

CREATE TABLE hubMessages (
    messageId TEXT NOT NULL PRIMARY KEY,    -- Hub ULID，upsert 合并键（05 §3.11）
    conversationId TEXT NOT NULL,
    seq INTEGER NOT NULL,                   -- 当前化身内插入顺序（新化身从 1 重计）
    role TEXT NOT NULL,                     -- user/assistant/""（""=compaction/reset 合成行，渲染分隔条）
    content TEXT NOT NULL,
    state TEXT NOT NULL,                    -- final/streaming/failed
    reason TEXT,                            -- v4：失败原因（事件路径 message.failed.reason = 快照路径 MessageRow.errorKind，六值脱敏闭集；仅 failed 行非空）
    uiState TEXT,                           -- 仅用户行：sending/delivered/read/failed
    commandId TEXT,
    idempotencyKey TEXT,
    ts TEXT
);
CREATE INDEX hubMessages_byConv ON hubMessages(conversationId, seq);
CREATE INDEX hubMessages_byIdem ON hubMessages(idempotencyKey);

-- 本地发送队列（O-01/O-08）：idempotencyKey 客户端生成 UUID 生成后永不更换；终态移入历史展示。
CREATE TABLE hubCommands (
    idempotencyKey TEXT NOT NULL PRIMARY KEY,
    commandId TEXT,                         -- PENDING_LOCAL 期尚未分配
    conversationId TEXT,                    -- REST 句柄（message.send/read.mark 必有）
    runId TEXT,
    approvalId TEXT,
    type TEXT NOT NULL,                     -- message.send/run.cancel/approval.decide/read.mark
    payloadJson TEXT NOT NULL,              -- 请求载荷原样（重试必须同键同内容，HUB-BIZ-001 禁换键）
    state TEXT NOT NULL,                    -- ADR-07 十态
    errorCode TEXT,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);
CREATE INDEX hubCommands_byState ON hubCommands(state);

CREATE TABLE hubReadCursors (
    conversationId TEXT NOT NULL PRIMARY KEY,
    readUpTo INTEGER NOT NULL DEFAULT 0     -- INV-7 只进不退：应用前取 max
);

CREATE TABLE hubApprovals (
    approvalId TEXT NOT NULL PRIMARY KEY,
    runId TEXT NOT NULL,
    conversationId TEXT,                    -- 事件路由查映射；未命中为 NULL（UI 未接，无碍）
    toolName TEXT NOT NULL,
    payloadSummary TEXT NOT NULL,
    status TEXT NOT NULL,                   -- pending/approved/rejected
    decidedBy TEXT,                         -- app/host
    updatedAt TEXT NOT NULL
);

-- O-01 持久化最小集：eventCursor（全局事件 ULID 单调不减）、snapshotWatermark。
CREATE TABLE hubSyncState (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- ── 查询 ─────────────────────────────────────────────────────────────────────

insertGateway:
INSERT OR REPLACE INTO hubGateways(gatewayId, name, online, lastSeenAt, agentsJson)
VALUES (?, ?, ?, ?, ?);

setGatewayOnline:
UPDATE hubGateways SET online = ?, lastSeenAt = ? WHERE gatewayId = ?;

-- 快照整体覆盖：投影表事务内清空（hubConvKeys/hubCommands/hubSyncState/hubApprovals 不清——
-- 映射与 O-01 持久化最小集、审批累积态跨重建保留，05 §3.6；映射失效项由下句清理）
clearGateways:
DELETE FROM hubGateways;

clearConversations:
DELETE FROM hubConversations;

clearConvKeysOrphan:
DELETE FROM hubConvKeys WHERE conversationId NOT IN (SELECT conversationId FROM hubConversations);

clearMessages:
DELETE FROM hubMessages;

clearReadCursors:
DELETE FROM hubReadCursors;

-- 登出全清（P4 验收⑤：登出 = 撤销当前设备 + 清全部本地数据）。与快照重建不同，
-- 此处连映射、O-01 最小集（命令队列/游标）与审批累积态一并清：设备已撤销，本地不应残留
-- 任何账号数据；重登后从空库 bootstrap。
clearConvKeys:
DELETE FROM hubConvKeys;

clearCommands:
DELETE FROM hubCommands;

clearApprovals:
DELETE FROM hubApprovals;

clearSyncState:
DELETE FROM hubSyncState;

selectGateways:
SELECT * FROM hubGateways ORDER BY name;

-- 快照/列表落定的卡片灌入（v1.1 行无 sessionKey/revision；conversationId 是主键）。
-- gatewayId 为快照/校准行 required（v5 透出）；activeRunId 不在快照/校准面上：inactive 校准
-- 连带清空（防死 runId 残留），active 时保留事件习得值。
upsertConversation:
INSERT INTO hubConversations
(conversationId, gatewayId, sessionKey, label, agentId, lastMessagePreview, lastSeq, lastActiveAt,
 unreadCount, hasActiveRun, reconciling, lifecycleRevision)
VALUES (?, ?, NULL, ?, ?, ?, ?, ?, ?, ?, ?, -1)
ON CONFLICT(conversationId) DO UPDATE SET
  gatewayId = excluded.gatewayId,
  label = excluded.label,
  agentId = excluded.agentId,
  lastMessagePreview = excluded.lastMessagePreview,
  lastSeq = excluded.lastSeq,
  lastActiveAt = excluded.lastActiveAt,
  unreadCount = excluded.unreadCount,
  hasActiveRun = excluded.hasActiveRun,
  activeRunId = CASE WHEN excluded.hasActiveRun = 0 THEN NULL ELSE hubConversations.activeRunId END,
  reconciling = excluded.reconciling;

-- 映射学习/回填（自发送回执链与自命令 ack；只加速路由，不作存在性判定）
upsertConvKey:
INSERT INTO hubConvKeys(gatewayId, sessionKey, conversationId) VALUES (?, ?, ?)
ON CONFLICT(gatewayId, sessionKey) DO UPDATE SET conversationId = excluded.conversationId;

-- 队列条目反查 conversationId（映射学习通道 b/c）
selectCommandByKey:
SELECT * FROM hubCommands WHERE idempotencyKey = ?;

selectConversation:
SELECT * FROM hubConversations WHERE conversationId = ?;

selectConversationByKey:
SELECT * FROM hubConvKeys WHERE gatewayId = ? AND sessionKey = ?;

selectConversations:
SELECT * FROM hubConversations ORDER BY lastActiveAt DESC;

deleteConversation:
DELETE FROM hubConversations WHERE conversationId = ?;

deleteConvKey:
DELETE FROM hubConvKeys WHERE gatewayId = ? AND sessionKey = ?;

-- session.updated（映射命中后）：label 空 = 载荷未带，保留旧值；revision 持久基准更新；
-- inactive 时连带清空 activeRunId（v4：聚合信号说无活跃 run，事件习得的 runId 不得残留）
updateConversationIdentity:
UPDATE hubConversations SET
  label = CASE WHEN :label = '' THEN label ELSE :label END,
  hasActiveRun = :hasActiveRun,
  activeRunId = CASE WHEN :hasActiveRun = 0 THEN NULL ELSE activeRunId END,
  lifecycleRevision = :revision
WHERE conversationId = :conversationId;

-- run.* 事件（v4）：hasActiveRun 翻转 + 当前活跃 runId 捕获/清空（wp-8 Stop 按钮取值；
-- 终态事件 activeRunId 置 NULL，与 hasActiveRun=0 同步）
setConversationActiveRun:
UPDATE hubConversations SET hasActiveRun = ?, activeRunId = ? WHERE conversationId = ?;

-- 化身更替（session.updated lifecycleRevision 变化）：旧代次封存移出、seq 从 1 重计、
-- 未读清零、readCursor 重置（05 §3.10；消息行无化身列，以显式信号整体清空）；
-- 旧化身活跃 run 一并作废（activeRunId 清空）
resetConversationIncarnation:
UPDATE hubConversations SET lastSeq = 0, unreadCount = 0, activeRunId = NULL WHERE conversationId = ?;

setConversationUnread:
UPDATE hubConversations SET unreadCount = ? WHERE conversationId = ?;

setConversationReconciling:
UPDATE hubConversations SET reconciling = ? WHERE conversationId = ?;

-- 消息落定驱动会话尾行（message.created）
touchConversationPreview:
UPDATE hubConversations SET
  lastMessagePreview = :preview, lastSeq = MAX(lastSeq, :seq), lastActiveAt = :lastActiveAt
WHERE conversationId = :conversationId;

upsertMessage:
INSERT OR REPLACE INTO hubMessages
(messageId, conversationId, seq, role, content, state, uiState, commandId, idempotencyKey, ts, reason)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- delta 追加（replace=false）：流式行内容拼接
appendMessageContent:
UPDATE hubMessages SET content = content || ? WHERE messageId = ?;

-- delta 权威快照替换（replace=true）与 message.replaced 整替共用
replaceMessageContent:
UPDATE hubMessages SET content = ? WHERE messageId = ?;

setMessageState:
UPDATE hubMessages SET state = ? WHERE messageId = ?;

-- 失败终态 + 原因落库（v4：事件路径 message.failed.reason；与快照路径 errorKind 共用 reason 列）
setMessageStateReason:
UPDATE hubMessages SET state = ?, reason = ? WHERE messageId = ?;

-- 异锚收敛清除（v4，wp-5①主分支）：权威终态行落定时，同会话除保留行（含本行——同锚分支
-- 由 upsert 覆盖收敛）外的全部流式占位行清除，防流式幽灵气泡+重复 final 气泡
deleteStreamingPlaceholdersExcept:
DELETE FROM hubMessages WHERE conversationId = ? AND state = 'streaming' AND messageId != ?;

-- run 终态清除（v4）：失败/中止 run 无 message 终态事件可收敛其占位行，活跃 run 结束即
-- 清除会话全部流式行（单活跃 run 模型一致性；正常完成时占位行已被 created 清除，此处为兜底）
deleteStreamingRows:
DELETE FROM hubMessages WHERE conversationId = ? AND state = 'streaming';

-- 用户行回执到达：同 idempotencyKey 的本地乐观行（messageId=临时键）整体提升为服务端行，
-- 避免乐观行+服务端行双行并存（05 §3.9 义务 4 的 UI 翻转语义）
promoteLocalEcho:
UPDATE hubMessages SET messageId = :messageId, content = :content, seq = :seq,
  uiState = 'delivered', commandId = :commandId, ts = :ts
WHERE idempotencyKey = :idempotencyKey;

selectMessageByIdem:
SELECT idempotencyKey, conversationId FROM hubMessages WHERE idempotencyKey = ? LIMIT 1;

setMessageUiStateByIdem:
UPDATE hubMessages SET uiState = ? WHERE idempotencyKey = ? AND state != 'failed';

selectMessage:
SELECT * FROM hubMessages WHERE messageId = ?;

selectMessages:
SELECT * FROM hubMessages WHERE conversationId = ? ORDER BY seq;

selectMessagesBefore:
SELECT * FROM hubMessages WHERE conversationId = ? AND seq < ?
ORDER BY seq DESC LIMIT :limit;

-- 本地未读重算（与 Hub 口径同式：当前化身内 seq > readUpTo 且 role=assistant 的 final 行；
-- role="" 合成行不计）
countUnread:
SELECT COUNT(*) FROM hubMessages
WHERE conversationId = ? AND seq > ? AND role = 'assistant' AND state = 'final';

deleteMessagesByConversation:
DELETE FROM hubMessages WHERE conversationId = ?;

insertCommand:
INSERT OR REPLACE INTO hubCommands
(idempotencyKey, commandId, conversationId, runId, approvalId, type, payloadJson, state, errorCode, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCommandState:
UPDATE hubCommands SET state = ?, errorCode = ?, updatedAt = ? WHERE idempotencyKey = ?;

updateCommandId:
UPDATE hubCommands SET commandId = ?, updatedAt = ? WHERE idempotencyKey = ?;

selectNonTerminalCommands:
SELECT * FROM hubCommands WHERE state NOT IN ('COMPLETED', 'FAILED', 'CANCELLED', 'INDETERMINATE');

upsertReadCursor:
INSERT INTO hubReadCursors(conversationId, readUpTo) VALUES (?, ?)
ON CONFLICT(conversationId) DO UPDATE SET readUpTo = MAX(readUpTo, excluded.readUpTo);

selectReadCursor:
SELECT readUpTo FROM hubReadCursors WHERE conversationId = ?;

-- 化身更替时 readCursor 重置（upsertReadCursor 的 MAX 会阻止归零，须显式覆写）
setReadCursorValue:
INSERT INTO hubReadCursors(conversationId, readUpTo) VALUES (?, ?)
ON CONFLICT(conversationId) DO UPDATE SET readUpTo = excluded.readUpTo;

deleteReadCursor:
DELETE FROM hubReadCursors WHERE conversationId = ?;

upsertApproval:
INSERT OR REPLACE INTO hubApprovals
(approvalId, runId, conversationId, toolName, payloadSummary, status, decidedBy, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

setApprovalStatus:
UPDATE hubApprovals SET status = ?, decidedBy = ?, updatedAt = ? WHERE approvalId = ?;

selectPendingApprovals:
SELECT * FROM hubApprovals WHERE status = 'pending' ORDER BY updatedAt;

upsertSyncState:
INSERT OR REPLACE INTO hubSyncState(key, value) VALUES (?, ?);

selectSyncState:
SELECT value FROM hubSyncState WHERE key = ?;
