<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs 远程推送（wp-17 客户端上报 + 服务端推送链路）；distribution 签名时
	     profile 自动注入 production 环境，此处按惯例声明 development。 -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- 数据保护 keychain（refreshToken 持久化，HubPlatform.ios.kt）需要显式 keychain
	     访问组：自定义 entitlements 会替换 Xcode 默认生成的全组，缺此键真机 -34018。 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.sharpxia.agentreins</string>
	</array>
</dict>
</plist>
